{
    "name": "axis-dtl",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "test": "bun test --timeout 30000 ./tests/node ./sdk ./scripts",
        "test:rust": "cargo test --locked",
        "test:all": "cargo test --locked && bun test --timeout 30000 ./tests/node ./sdk ./scripts",
        "ci": "bash scripts/ci.sh",
        "build": "bun scripts/check-js.mjs",
        "fmt": "prettier --write --config .prettierrc --ignore-path .prettierignore \"**/*.{js,json,md,mjs,yml}\"",
        "fmt:check": "prettier --check --config .prettierrc --ignore-path .prettierignore \"**/*.{js,json,md,mjs,yml}\""
    },
    "devDependencies": {
        "prettier": "3.9.4"
    },
    "engines": {
        "bun": "1.3.14"
    }
}
